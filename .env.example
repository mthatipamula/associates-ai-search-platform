# Copy to .env  (cp .env.example .env)

# Embeddings: local (fastembed bge-small, 384 dims) | bedrock (Titan v2) | hash (tests only)
EMBED_PROVIDER=local
EMBED_DIMS=384

# LLM: none (offline fallbacks) | anthropic | bedrock
LLM_PROVIDER=none
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
# ANTHROPIC_API_KEY=...
# AWS_REGION=us-east-1   (bedrock: standard AWS credential chain)

# Re-ranking: replace | blend | entity_aware (default; blend only when a client/hospital is named)
# RERANK_STRATEGY=entity_aware
