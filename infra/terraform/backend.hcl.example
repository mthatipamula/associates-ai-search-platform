# Copy to backend.hcl (git-ignored) and run: terraform init -backend-config=backend.hcl
# Create the bucket once (versioning on), e.g.:
#   aws s3api create-bucket --bucket <your-unique-bucket> --region us-east-1
#   aws s3api put-bucket-versioning --bucket <your-unique-bucket> --versioning-configuration Status=Enabled
bucket       = "<your-unique-terraform-state-bucket>"
key          = "kp-search/demo/terraform.tfstate"
region       = "us-east-1"
encrypt      = true
use_lockfile = true # S3-native state locking, no DynamoDB table needed
